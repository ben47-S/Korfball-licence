// ==============================
// GENERATOR & DATASOURCE
// ==============================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==============================
// ENUMS
// ==============================

enum TypeLicence {
  NOUVEAU
  RENOUVELLEMENT
}

enum StatutLicence {
  BROUILLON
  SOUMISE
  VALIDEE
  REJETEE
}

enum StatutPaiement {
  EN_ATTENTE
  VALIDE
  ECHOUE
}

enum Role {
  ADMIN
  AGENT
}

enum LienResponsable {
  PERE
  MERE
  TUTEUR
}

// ==============================
// MODELS
// ==============================

model User {
  id        String  @id @default(uuid()) @db.Uuid
  nom       String
  prenom    String
  email     String  @unique
  telephone String?
  role      Role

  createdAt DateTime @default(now())
}

model Joueur {
  id            String   @id @default(uuid()) @db.Uuid
  nom           String
  prenom        String
  email         String?
  telephone     String
  dateNaissance DateTime
  lieuNaissance String
  nationalite   String
  sexe          String
  photo         String?
  signature     String?
  pieceIdentite       String?
  certificatMedical   String?

  // Numéro de licence unique par joueur (attribué lors de la première validation)
  // Format: FIK-YYYY-XXXXXX (ex: FIK-2024-123456)
  numeroLicence String? @unique

  responsables Responsable[]
  licences     Licence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Responsable {
  id        String          @id @default(uuid()) @db.Uuid
  nom       String
  prenom    String
  telephone String
  email     String?
  lien      LienResponsable

  joueurId String @db.Uuid
  joueur   Joueur @relation(fields: [joueurId], references: [id], onDelete: Cascade)
}

model Club {
  id    String  @id @default(uuid()) @db.Uuid
  nom   String
  ville String
  pays  String

  licencesActuelles   Licence[] @relation("ClubActuel")
  licencesPrecedentes Licence[] @relation("ClubPrecedent")

  createdAt DateTime @default(now())
}

model Saison {
  id    String   @id @default(uuid()) @db.Uuid
  code  String   @unique // ex: 2024-2025
  debut DateTime
  fin   DateTime

  // Période pour saisir les licences
  inscriptionDebut DateTime
  inscriptionFin   DateTime

  // Saison en cours pour les inscriptions
  enCours Boolean @default(false)

  licences Licence[]
}

model Licence {
  id String @id @default(uuid()) @db.Uuid

  joueurId String @db.Uuid
  joueur   Joueur @relation(fields: [joueurId], references: [id], onDelete: Cascade)

  saisonId String @db.Uuid
  saison   Saison @relation(fields: [saisonId], references: [id])

  clubPrecedentId String? @db.Uuid
  clubPrecedent   Club?   @relation("ClubPrecedent", fields: [clubPrecedentId], references: [id])

  clubActuelId String? @db.Uuid
  clubActuel   Club?   @relation("ClubActuel", fields: [clubActuelId], references: [id])

  type          TypeLicence
  statut        StatutLicence @default(BROUILLON)

  paiement Paiement?

  dateValidation   DateTime?
  commentaireAdmin String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([joueurId, saisonId])
}

model Paiement {
  id String @id @default(uuid()) @db.Uuid

  // --- CinetPay ---
  provider      String         @default("CINETPAY")
  transactionId String         @unique // ID retourné par CinetPay
  reference     String         @unique // référence interne
  montant       Float
  devise        String         @default("XOF")
  statut        StatutPaiement @default(EN_ATTENTE)

  // --- Relations ---
  licenceId String  @unique @db.Uuid
  licence   Licence @relation(fields: [licenceId], references: [id], onDelete: Cascade)

  // --- Meta ---
  paymentUrl  String? // lien de paiement CinetPay
  rawResponse String? // JSON string optionnel

  createdAt DateTime  @default(now())
  paidAt    DateTime?
}
